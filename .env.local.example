# ---------------------------------------------------------------------------
# Afnon — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public (browser-safe) read key.
# Either name works — the newer "publishable" name is preferred, the legacy
# "anon" name is still supported so existing projects keep working.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used exclusively by the admin
# panel's server actions to write to menu_items. Treat as a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# SERVER ONLY. The single shared password restaurant staff use at /admin.
ADMIN_PASSWORD=choose-a-long-random-password
